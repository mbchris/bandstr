# bandstr Web (Quasar) - environment variables
# Copy to .env.web (local dev)

# API base URL consumed by the web app at build time.
API_URL=http://localhost:3001

# Show extra login diagnostics in UI.
DEBUG_MODE=false

# Capacitor callback URL (must match your app id/scheme).
MOBILE_CALLBACK_URL=org.capacitor.bandstr://localhost/login

# Optional build revision shown in Impress footer.
# If empty, quasar.config.ts falls back to `git rev-parse --short HEAD`.
# GIT_REV=

# Optional default adb target for `./do build-apk`.
# ANDROID_DEVICE_ID=3B081JEHN00876
