#!/usr/bin/env bash

set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

print_header() {
  clear
  echo "========================================"
  echo "          m_bandstr do CLI Helper       "
  echo "========================================"
  echo
}

print_menu() {
  echo "Please select a task to run:"
  echo
  echo "  1) Build Production Image (./do build)"
  echo "  2) Build APK (./do build-apk production --no-install)"
  echo "  3) Create APK Bundle (./do create-apk-bundle)"
  echo "  4) Deploy to Play Console (./do deploy-play-console)"
  echo "  5) Build signed iOS IPA (./do build-ios production)"
  echo "  6) Upload IPA to App Store Connect (./do upload-ios production)"
  echo "  7) Show Apple account-owner checklist (./do appstore-checklist production)"
  echo "  8) Install iOS app on local device (using ios-deploy)"
  echo "  9) Install APK on local device (using ADB)"
  echo "  10) Build & Run iOS Simulator App"
  echo "  0) Quit"
  echo
}

run_command() {
  local num="$1"
  case "$num" in
    1) echo "Running: ./do build";                              ./do build ;;
    2) echo "Running: ./do build-apk production --no-install"; ./do build-apk production --no-install ;;
    3) echo "Running: ./do create-apk-bundle";                 ./do create-apk-bundle ;;
    4) echo "Running: ./do deploy-play-console";               ./do deploy-play-console ;;
    5) echo "Running: ./do build-ios production";              ./do build-ios production ;;
    6) echo "Running: ./do upload-ios production";             ./do upload-ios production ;;
    7) echo "Running: ./do appstore-checklist production";     ./do appstore-checklist production ;;
    8) echo "Running: ./do deploy-ios local";                  ./do deploy-ios local ;;
    9) echo "Running: ./do deploy-apk production";             ./do deploy-apk production ;;
    10) echo "Running iOS Simulator Build & Run...";           pnpm --filter @bandstr/web run build:ios --ide && (cd packages/web/src-capacitor && npx cap run ios) ;;
    0) echo "Exiting."; exit 0 ;;
    *) echo "Invalid option: $num"; return 1 ;;
  esac
}

while true; do
  print_header
  print_menu
  read -rp "Enter your choice (e.g. 1 or 2,4,5): " REPLY

  IFS=',' read -ra selections <<< "$REPLY"

  had_error=0
  for sel in "${selections[@]}"; do
    sel="${sel// /}"
    if ! run_command "$sel"; then
      had_error=1
      echo
      read -rp "Press Enter to return to main menu..."
      break
    fi
  done

  if [[ "$had_error" -eq 0 ]]; then
    read -rp "Press Enter to continue..."
  fi
done
