{
  "name": "@bandstr/web",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "prebuild": "bash ../../scripts/sync-assets.sh",
    "dev": "quasar dev",
    "build": "quasar build",
    "prebuild:ios": "bash ../../scripts/sync-assets.sh",
    "build:ios": "quasar build -m capacitor -T ios",
    "prebuild:android": "bash ../../scripts/sync-assets.sh",
    "build:android": "quasar build -m capacitor -T android",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@bandstr/shared": "workspace:*",
    "@capacitor/app": "^7.0.0",
    "@capacitor/filesystem": "^7.1.8",
    "@capacitor/push-notifications": "^7.0.6",
    "@capacitor/share": "^7.0.4",
    "@quasar/extras": "^1.16.12",
    "better-auth": "^1.5.6",
    "docx": "^9.7.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "marked": "^15.0.11",
    "pinia": "^2.3.1",
    "quasar": "^2.17.4",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@capacitor/android": "^7.2.0",
    "@capacitor/cli": "^7.2.0",
    "@capacitor/core": "^7.2.0",
    "@capacitor/ios": "^7.2.0",
    "@quasar/app-vite": "2.1.4",
    "@types/node": "^22.15.18",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/eslint-config-typescript": "^14.5.0",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^9.28.0",
    "eslint-plugin-vue": "^10.1.0",
    "happy-dom": "^20.14.5",
    "typescript": "^5.8.3",
    "vitest": "^5.0.2",
    "vue-tsc": "^2.2.10"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
