# ==============================================================================
# bandstr — Comprehensive Environment Template (.env.template)
# ==============================================================================
# Copy this file to `.env` for production / staging, or use `.env.api` and `.env.web`
# for targeted package development.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Application Routing
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3001
APP_DOMAIN=bandstr.apps.4ki.app
API_URL=https://bandstr.apps.4ki.app/api
APP_URL=https://bandstr.apps.4ki.app
SERVICE_FQDN_PROD=bandstr.apps.4ki.app
SERVICE_URL_PROD=https://bandstr.apps.4ki.app
SERVICE_FQDN_DEV=localhost
SERVICE_URL_DEV=https://localhost
DEVMODE=false
DEBUG_MODE=false
DEBUG_AUTO_ACTIVATE_USERS=false

# ------------------------------------------------------------------------------
# 2. Database (PostgreSQL)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://bandstr:bandstr_secret@localhost:5432/bandstr
# Optional: source database for data migration / import scripts
IMPORT_SOURCE_DATABASE_URL=

# ------------------------------------------------------------------------------
# 3. Authentication & Security (Better Auth)
# ------------------------------------------------------------------------------
# Must be at least 32 random characters
AUTH_SECRET=generate_a_random_32_character_secret_key_here
AUTH_ORIGIN=https://bandstr.apps.4ki.app
AUTH_TRUST_HOST=true
AUTH_SESSION_EXPIRES_IN_SECONDS=604800
CORS_ORIGINS=https://localhost:9000,https://bandstr.apps.4ki.app
INTERNAL_ADMIN_TOKEN=generate_an_admin_bearer_token_uuid_or_secret
WHITELIST_EMAILS=

# ------------------------------------------------------------------------------
# 4. OAuth Providers
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GHUB_CLIENT_ID=
GHUB_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# 5. Email Delivery (SMTP / Webhook)
# ------------------------------------------------------------------------------
# If AUTH_EMAIL_SMTP_HOST is configured, SMTP is used for transactional emails.
AUTH_EMAIL_SMTP_HOST=
AUTH_EMAIL_SMTP_PORT=587
AUTH_EMAIL_SMTP_STARTTLS=true
AUTH_EMAIL_SMTP_USER=
AUTH_EMAIL_SMTP_PASSWORD=
AUTH_EMAIL_SMTP_SERVER_NAME=
AUTH_EMAIL_SMTP_TLS_SERVER_NAME=
AUTH_EMAIL_SMTP_FROM_NAME=bandstr
AUTH_EMAIL_SMTP_FROM_EMAIL=noreply@bandstr.apps.4ki.app

# Fallback: Webhook sender (used if SMTP host is empty)
AUTH_EMAIL_WEBHOOK_URL=
AUTH_EMAIL_WEBHOOK_BEARER_TOKEN=

# ------------------------------------------------------------------------------
# 6. Support & Feedback (GitHub Issues Integration)
# ------------------------------------------------------------------------------
SUPPORT_GITHUB_ISSUES_URL=https://github.com/prj120/bandstr/issues
SUPPORT_GITHUB_TOKEN=
SUPPORT_GITHUB_ASSIGNEES=
GH_PROJECT_OWNER=mbchris
GH_TOKEN=

# ------------------------------------------------------------------------------
# 7. Billing & Subscriptions (Stripe)
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=

# ------------------------------------------------------------------------------
# 8. WebUI & Mobile Hybrid Frontend
# ------------------------------------------------------------------------------
MOBILE_CALLBACK_URL=org.capacitor.bandstr://localhost/login
PACKAGE_NAME=org.capacitor.bandstr

# ------------------------------------------------------------------------------
# 9. Push Notifications
# ------------------------------------------------------------------------------
# 9.1 Android Push (Firebase Cloud Messaging - FCM HTTP v1)
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_EMAIL=
FCM_SERVICE_ACCOUNT_PRIVATE_KEY=
FCM_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_APPLICATION_CREDENTIALS_JSON=
GOOGLE_APPLICATION_CREDENTIALS_JSON_BASE64=
GOOGLE_SERVICES_JSON_PATH=
GOOGLE_SERVICES_JSON_BASE64=

# 9.2 iOS Push (Apple Push Notification service - APNs HTTP/2 direct)
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=-ki.app.bandstr
APNS_USE_SANDBOX=false

# 9.3 Web Push (VAPID / Service Worker)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@bandstr.apps.4ki.app

# ------------------------------------------------------------------------------
# 10. Android Build & Google Play Store (Release & CI/CD)
# ------------------------------------------------------------------------------
# Release Keystore (Base64 encoded .keystore or .jks)
ANDROID_SIGNING_KEYSTORE_BASE64=
ANDROID_SIGNING_KEY_ALIAS=***REMOVED***
ANDROID_SIGNING_KEYSTORE_PASSWORD=
ANDROID_SIGNING_KEY_PASSWORD=

# Google Play Console Deployment
GPLAY_PACKAGE_NAME=org.capacitor.bandstr
GPLAY_SERVICE_ACCOUNT_JSON=
PLAY_CONSOLE_TRACK=internal
GPLAY_PRODUCT_PRO_MONTHLY=
GPLAY_PRODUCT_PRO_YEARLY=
GPLAY_RTDN_TOKEN=

# Optional local testing device
ANDROID_DEVICE_ID=

# ------------------------------------------------------------------------------
# 11. iOS Build & Apple App Store / TestFlight (Release & CI/CD)
# ------------------------------------------------------------------------------
APPLE_BUNDLE_ID=org.capacitor.bandstr
APPLE_TEAM_ID=

# iOS Signing Credentials for GitHub Actions Runner
APPLE_DISTRIBUTION_CERT_BASE64=
APPLE_DISTRIBUTION_CERT_PASSWORD=
APPLE_PROVISIONING_PROFILE_BASE64=

# App Store Connect API Credentials (for TestFlight upload)
APPSTORE_CONNECT_API_KEY_ID=
APPSTORE_CONNECT_ISSUER_ID=
APPSTORE_CONNECT_API_KEY_BASE64=
APPSTORE_CONNECT_API_KEY_PATH=

# In-App Purchases (App Store)
APPLE_PRODUCT_PRO_MONTHLY=
APPLE_PRODUCT_PRO_YEARLY=
ALLOW_INSECURE_APPLE_ACTIVATE=false

# Optional local iOS export / device target
IOS_EXPORT_OPTIONS_PLIST=
IOS_DEVICE_ID=

# ------------------------------------------------------------------------------
# 12. Deployment & Hosting (Coolify)
# ------------------------------------------------------------------------------
COOLIFY_DEPLOY_URL=
COOLIFY_AUTH_TOKEN=
COOLIFY_CONTAINER_NAME=bandstr-prod

# ------------------------------------------------------------------------------
# 13. Build & Git Metadata
# ------------------------------------------------------------------------------
SOURCE_COMMIT=
GIT_REV=
bandstr_GIT_REV=

AUTH_EMAIL_SMTP_HOST={{team.SMTP_HOST}}
AUTH_EMAIL_SMTP_PORT={{team.SMTP_PORT}}
AUTH_EMAIL_SMTP_USER={{team.SMTP_USER}}
AUTH_EMAIL_SMTP_PASSWORD={{team.SMTP_PASSWORD}}
AUTH_EMAIL_SMTP_FROM_EMAIL={{team.SMTP_USER}}