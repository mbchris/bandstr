# ── Stage 1: Build ────────────────────────────────
FROM node:20-alpine AS build

ARG GIT_REV=unknown
ARG SOURCE_COMMIT=unknown

WORKDIR /app

# Enable Corepack (pnpm version comes from packageManager in package.json)
RUN corepack enable
RUN apk add --no-cache git bash

# Copy workspace root files
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* ./

# Copy package.json for each workspace package
COPY packages/web/package.json packages/web/
COPY packages/shared/package.json packages/shared/

# Install dependencies
RUN pnpm install --filter @bandstr/web --filter @bandstr/shared --frozen-lockfile || pnpm install --filter @bandstr/web --filter @bandstr/shared

# Copy full repository context (including .git when available)
COPY . .

# Build-time env — API_URL is injected at build time for the SPA bundle
ARG API_URL=/api
ENV API_URL=${API_URL}
ENV GIT_REV=${GIT_REV}
ENV SOURCE_COMMIT=${SOURCE_COMMIT}

# Build Quasar SPA
RUN cd packages/web && pnpm run build

# ── Stage 2: Serve with Nginx ─────────────────────
FROM nginx:1.27-alpine AS production

ARG GIT_REV=unknown
ARG SOURCE_COMMIT=unknown

# Remove default config
RUN rm /etc/nginx/conf.d/default.conf

# Copy custom Nginx config
COPY nginx.conf /etc/nginx/conf.d/bandstr.conf

# Copy built SPA from build stage
COPY --from=build /app/packages/web/dist/spa/ /usr/share/nginx/html/

ENV GIT_REV=${GIT_REV}
ENV SOURCE_COMMIT=${SOURCE_COMMIT}

LABEL org.opencontainers.image.title="bandstr-web"
LABEL org.opencontainers.image.version="${GIT_REV}"
LABEL org.opencontainers.image.revision="${SOURCE_COMMIT}"

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
