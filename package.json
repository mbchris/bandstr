{
  "name": "bandstr",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
  "description": "bandstr — multi-tenant band management SaaS",
  "scripts": {
    "prebuild": "bash ./scripts/sync-assets.sh",
    "dev": "pnpm --parallel -r run dev",
    "dev:api": "pnpm --filter @bandstr/api run dev",
    "dev:web": "pnpm --filter @bandstr/web run dev",
    "build": "pnpm -r run build",
    "build:api": "pnpm --filter @bandstr/api run build",
    "build:web": "pnpm --filter @bandstr/web run build",
    "mobile:setup": "powershell -ExecutionPolicy Bypass -File ./scripts/setup-capacitor.ps1",
    "mobile:android:keygen": "bash ./scripts/create-android-signing-key.sh",
    "mobile:android": "pnpm --filter @bandstr/web run build:android",
    "mobile:ios": "pnpm --filter @bandstr/web run build:ios",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "test:api": "pnpm --filter @bandstr/api run test",
    "test:web": "pnpm --filter @bandstr/web run test",
    "lint": "pnpm -r run lint",
    "security:code": "pnpm --dir packages/web audit --audit-level=high",
    "security:backend": "pnpm --dir packages/api audit --audit-level=high",
    "security": "bash ./scripts/security-scan.sh",
    "db:generate": "pnpm --filter @bandstr/api run db:generate",
    "db:migrate": "pnpm --filter @bandstr/api run db:migrate",
    "db:migrate:runtime": "pnpm --filter @bandstr/api run db:migrate:runtime",
    "db:init": "bash ./scripts/init-empty-db.sh",
    "db:reset": "bash ./scripts/reset-db.sh",
    "db:studio": "pnpm --filter @bandstr/api run db:studio",
    "db:seed": "pnpm --filter @bandstr/api run db:seed",
    "cli:admin": "pnpm --filter @bandstr/api run cli:admin",
    "cli:admin:dev": "pnpm --filter @bandstr/api run cli:admin:dev"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "better-sqlite3",
      "esbuild",
      "sqlite3",
      "vue-demi"
    ],
    "patchedDependencies": {
      "@quasar/app-vite@2.1.4": "patches/@quasar__app-vite@2.1.4.patch"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "googleapis": "^171.4.0"
  }
}
