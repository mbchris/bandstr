# bandstr API - environment variables
# Copy to .env.api (local dev) or configure in your deployment runtime.

# Server
NODE_ENV=development
PORT=3001
API_URL=http://localhost:3001

# Database
# Local dev: run postgres via docker-compose.dev.yml
DATABASE_URL=postgresql://bandstr:bandstr_dev@localhost:5432/bandstr

# Auth
AUTH_SECRET=generate_a_random_secret_here_at_least_32_chars
CORS_ORIGINS=http://localhost:9000

# OAuth providers
# Google OAuth (Sign in with Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub OAuth (Sign in with GitHub)
GHUB_CLIENT_ID=
GHUB_CLIENT_SECRET=
# Apple OAuth (Sign in with Apple) - Required for App Store submission (Guideline 4.8)
# APPLE_CLIENT_ID: Apple Services ID configured in Apple Developer portal (e.g., org.capacitor.bandstr.client)
APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET: Generated ES256 client secret JWT signed with Apple Developer private key (.p8)
APPLE_CLIENT_SECRET=

# Auth mail delivery (used for email verification + password reset + email change)
# CRITICAL FOR APP STORE SUBMISSION (Guideline 2.1(a)):
# When new users register, an email verification link is sent. A working SMTP configuration
# is required in production so Apple reviewers and end users receive verification emails.
# If SMTP is not configured and no webhook is provided, emails are only logged to the console (dev mode).
#
# Preferred: SMTP sender. If AUTH_EMAIL_SMTP_HOST is set, SMTP is used.
# Alias names also supported: SMTP_SERVER/PORT/STARTTLS/USER/PASSWORD/SERVER_NAME/TLS_SERVER_NAME/FROM_ADDRESS
#
# AUTH_EMAIL_SMTP_HOST: Hostname of your SMTP relay server (e.g. smtp.sendgrid.net, smtp.mailgun.org, email-smtp.us-east-1.amazonaws.com)
AUTH_EMAIL_SMTP_HOST=
# AUTH_EMAIL_SMTP_PORT: SMTP port (usually 587 for STARTTLS submission, or 465 for SSL/TLS)
AUTH_EMAIL_SMTP_PORT=587
# AUTH_EMAIL_SMTP_STARTTLS: Whether to use STARTTLS (default: true for port 587). Set to false if connecting via port 465 (implicit TLS)
AUTH_EMAIL_SMTP_STARTTLS=true
# AUTH_EMAIL_SMTP_USER: SMTP authentication username (e.g. postmaster@yourdomain.com or API user)
AUTH_EMAIL_SMTP_USER=
# AUTH_EMAIL_SMTP_PASSWORD: SMTP authentication password or API key
AUTH_EMAIL_SMTP_PASSWORD=
# AUTH_EMAIL_SMTP_FROM_NAME: Sender display name shown in email clients (defaults to "bandstr")
AUTH_EMAIL_SMTP_FROM_NAME=bandstr
# AUTH_EMAIL_SMTP_FROM_EMAIL: Sender email address (e.g. no-reply@bandstr.com). Must be authorized in your SMTP provider to satisfy SPF/DKIM
AUTH_EMAIL_SMTP_FROM_EMAIL=
# Optional: SMTP client hostname used in HELO/EHLO (defaults to "localhost")
AUTH_EMAIL_SMTP_SERVER_NAME=
# Optional: TLS SNI/certificate server name (defaults to AUTH_EMAIL_SMTP_HOST)
AUTH_EMAIL_SMTP_TLS_SERVER_NAME=

# Fallback: webhook sender. If SMTP is not configured and AUTH_EMAIL_WEBHOOK_URL is empty,
# mails are logged to API console.
AUTH_EMAIL_WEBHOOK_URL=
AUTH_EMAIL_WEBHOOK_BEARER_TOKEN=

# Support -> GitHub Issues integration
# Default issue target: https://github.com/prj120/bandstr/issues
SUPPORT_GITHUB_ISSUES_URL=https://github.com/prj120/bandstr/issues
SUPPORT_GITHUB_TOKEN=

# Billing (Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=

# Billing (Google Play)
GPLAY_PACKAGE_NAME=
GPLAY_PRODUCT_PRO_MONTHLY=
GPLAY_PRODUCT_PRO_YEARLY=

# Billing (Apple App Store)
APPLE_BUNDLE_ID=
APPLE_PRODUCT_PRO_MONTHLY=
APPLE_PRODUCT_PRO_YEARLY=

# Native OS Push Notifications
# Android (FCM): either provide JSON blob OR separate email/private key + project id.
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
FCM_SERVICE_ACCOUNT_EMAIL=
FCM_SERVICE_ACCOUNT_PRIVATE_KEY=
# Optional existing credentials variables accepted as fallback:
GOOGLE_APPLICATION_CREDENTIALS_JSON=
GOOGLE_APPLICATION_CREDENTIALS_JSON_BASE64=
# iOS (APNs token auth)
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=org.capacitor.bandstr
APNS_USE_SANDBOX=true
# Optional Android helpers for `./do push-setup`
GOOGLE_SERVICES_JSON_PATH=
GOOGLE_SERVICES_JSON_BASE64=

# Web Push (VAPID / Service Worker)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@bandstr.apps.4ki.app

# Internal admin endpoints
INTERNAL_ADMIN_TOKEN=

# Optional
# Explicit web app URL used for billing redirect URLs. If empty, API derives it from CORS_ORIGINS/request origin.
APP_URL=
# Build/version metadata used by /health
GIT_REV=dev
SOURCE_COMMIT=
